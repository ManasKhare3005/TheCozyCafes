NODE_ENV=production
PORT=3001

CLIENT_URL=https://app.your-domain.example
APP_URL=https://app.your-domain.example
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
REDIS_URL=rediss://USER:PASSWORD@HOST:6379

# Generate with: openssl rand -base64 64
JWT_SECRET=<64-byte-random-secret>
IP_BAN_HASH_SECRET=<64-byte-random-secret-for-ip-ban-hashes>
JWT_EXPIRES_IN=7d

LOG_LEVEL=info
SENTRY_DSN=https://PUBLIC_KEY@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

ENFORCE_HTTPS=true
TRUST_PROXY=1
HTTPS_REDIRECT_ORIGIN=https://app.your-domain.example
HSTS_MAX_AGE=31536000

REQUIRE_EMAIL_VERIFICATION=true
AUTH_DEBUG_TOKENS=false
HCAPTCHA_SECRET=<hcaptcha-secret>

RESEND_API_KEY=<resend-api-key>
EMAIL_FROM="Chat Room Cafe <noreply@your-domain.example>"

CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
# Optional Cloudinary moderation add-on, for example aws_rek or webpurify.
CLOUDINARY_UPLOAD_MODERATION=

GROQ_API_KEY=<groq-api-key>
GIPHY_API_KEY=<giphy-api-key>

# Comma-separated extra terms blocked by server-side text moderation.
# Keep high-severity slur lists in the secret manager rather than source control.
CONTENT_BANNED_TERMS=
