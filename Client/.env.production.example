VITE_API_URL=https://api.your-domain.example/api
VITE_SOCKET_URL=https://api.your-domain.example
VITE_HCAPTCHA_SITE_KEY=<hcaptcha-site-key>
VITE_REQUIRE_HCAPTCHA=true
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_KOFI_URL=https://ko-fi.com/thecozycafes

# TURN relay for voice/video calls — strongly recommended in production;
# without it, calls fail for users behind symmetric NAT / strict firewalls.
VITE_TURN_URL=turn:turn.your-domain.example:3478
VITE_TURN_USERNAME=<turn-username>
VITE_TURN_CREDENTIAL=<turn-credential>
